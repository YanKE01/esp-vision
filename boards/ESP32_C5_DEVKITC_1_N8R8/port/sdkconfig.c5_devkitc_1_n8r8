# ESP-VISION ESP32-C5-DevKitC-1-N8R8 target defaults.

# Flash
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

# PSRAM
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_QUAD=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=8192

# Bring-up target: no Bluetooth/WebREPL path on ESP32-C5.
CONFIG_BT_ENABLED=
CONFIG_BT_NIMBLE_ENABLED=
CONFIG_BT_CONTROLLER_ENABLED=
CONFIG_NIMBLE_ENABLED=

# USB Serial/JTAG is the runtime IDE transport on ESP32-C5.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG=
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG_ENABLED=
CONFIG_USJ_ENABLE_USB_SERIAL_JTAG=
